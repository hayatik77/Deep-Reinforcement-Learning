import gym
import numpy as np
import tensorflow as tf
from tensorflow.keras import layers
import matplotlib.pyplot as plt

# Set up the Gym environment
env = gym.make("CartPole-v1")
action_size = env.action_space.n
state_size = env.observation_space.shape[0]

# Build the Deep Q-Network (DQN) model
def build_model():
    model = tf.keras.Sequential([
        layers.Dense(24, activation='relu', input_shape=(state_size,)),
        layers.Dense(24, activation='relu'),
        layers.Dense(action_size, activation='linear')  # Output layer with one value per action
    ])
    model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.001), loss='mse')
    return model

# Hyperparameters
batch_size = 64
gamma = 0.99  # Discount factor for future rewards
epsilon = 1.0  # Exploration rate (epsilon-greedy)
epsilon_decay = 0.995  # Decay rate for epsilon
epsilon_min = 0.01  # Minimum epsilon
learning_starts = 1000  # Start learning after this many time steps
replay_buffer_size = 10000
update_target_model_freq = 5

# Initialize replay buffer and target model
replay_buffer = []
model = build_model()
target_model = build_model()
target_model.set_weights(model.get_weights())

# Function to select actions based on epsilon-greedy strategy
def select_action(state):
    if np.random.rand() <= epsilon:
        return np.random.choice(action_size)  # Random action (exploration)
    q_values = model.predict(np.expand_dims(state, axis=0), verbose=0)
    return np.argmax(q_values[0])  # Best action (exploitation)

# Function to store experience in replay buffer
def store_experience(state, action, reward, next_state, done):
    replay_buffer.append((state, action, reward, next_state, done))
    if len(replay_buffer) > replay_buffer_size:
        replay_buffer.pop(0)

# Function to sample a batch of experiences
def sample_batch():
    return np.random.choice(replay_buffer, batch_size)

# Training loop
episodes = 1000
for episode in range(episodes):
    state = env.reset()
    state = np.array(state)
    done = False
    total_reward = 0
    
    while not done:
        action = select_action(state)
        next_state, reward, done, _ = env.step(action)
        next_state = np.array(next_state)
        
        store_experience(state, action, reward, next_state, done)
        state = next_state
        
        # Update model if we have enough experiences
        if len(replay_buffer) >= learning_starts:
            batch = sample_batch()
            states = np.array([item[0] for item in batch])
            actions = np.array([item[1] for item in batch])
            rewards = np.array([item[2] for item in batch])
            next_states = np.array([item[3] for item in batch])
            dones = np.array([item[4] for item in batch])
            
            q_values = model.predict(states)
            next_q_values = target_model.predict(next_states)
            
            # Update Q-values for actions taken
            for i in range(batch_size):
                if dones[i]:
                    q_values[i][actions[i]] = rewards[i]
                else:
                    q_values[i][actions[i]] = rewards[i] + gamma * np.max(next_q_values[i])

            model.fit(states, q_values, epochs=1, verbose=0)
        
        # Update target model
        if episode % update_target_model_freq == 0:
            target_model.set_weights(model.get_weights())
        
        total_reward += reward
    
    # Decay epsilon (exploration rate)
    if epsilon > epsilon_min:
        epsilon *= epsilon_decay
    
    # Print progress
    if episode % 50 == 0:
        print(f"Episode {episode}/{episodes} - Total Reward: {total_reward} - Epsilon: {epsilon}")

# Save the model after training
model.save('dqn_model.h5')
